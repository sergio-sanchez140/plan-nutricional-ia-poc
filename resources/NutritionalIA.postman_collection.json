		{
			"name": "Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 200) {\r",
							"    var jsonData = pm.response.json();\r",
							"    if (jsonData.access_token) {\r",
							"        // Guardamos el token con \"Bearer \" delante\r",
							"        pm.environment.set(\"access_token\", \"Bearer \" + jsonData.access_token);\r",
							"        console.log(\"Token guardado correctamente.\");\r",
							"    } else {\r",
							"        console.warn(\"No se encontró access_token en la respuesta.\");\r",
							"    }\r",
							"} else {\r",
							"    console.warn(\"Login fallido. Código:\", pm.response.code);\r",
							"}"
